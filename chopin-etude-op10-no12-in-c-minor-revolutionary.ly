\version "2.26.0"
\language "nederlands"
#(ly:set-option 'midi-extension "mid")
\pointAndClickOff

\header {
  pdftitle = "Étude in C minor, Op. 10 No. 12 (Revolutionary)"
  midititle = "Étude in C minor, Op. 10 No. 12 (Revolutionary)"
  title = \markup \override #'(font-name . "Times New Roman, Liberation Serif, C059") \abs-fontsize #24 "Étude “Revolutionary”"
  subtitle = \markup \override #'(font-name . "Times New Roman, Liberation Serif, C059") \abs-fontsize #14 "in C minor, Op. 10 No. 12"
  composer = \markup \override #'(font-name . "Times New Roman, Liberation Serif, C059") \abs-fontsize #11.5 "Frédéric François Chopin"
  composerDates = \markup \override #'(font-name . "Times New Roman, Liberation Serif, C059") \abs-fontsize #11.5 "(1810 – 1849)"
  tagline = ##f
}
#(set-global-staff-size 16)
\paper {
  #(set-paper-size "a4")
  top-margin = 9\mm
  bottom-margin = 9\mm
  left-margin = 9\mm
  right-margin = 9\mm
  indent = 3\mm
  short-indent = 2\mm
  ragged-last-bottom = ##t
  top-markup-spacing = #'((basic-distance . 0) (minimum-distance . 0) (padding . 0.3) (stretchability . 0))
  bookTitleMarkup = \markup \column {
    \fill-line { \fromproperty #'header:title }
    \vspace #0.8
    \overlay {
      \fill-line { \fromproperty #'header:subtitle }
      \fill-line { "" \fromproperty #'header:composer }
    }
    \vspace #0.7
    \fill-line { "" \fromproperty #'header:composerDates }
  }
  oddHeaderMarkup = \markup \fill-line { "" \if \should-print-page-number \abs-fontsize #9 \fromproperty #'page:page-number-string }
  evenHeaderMarkup = \markup \fill-line { \if \should-print-page-number \abs-fontsize #9 \fromproperty #'page:page-number-string "" }
  oddFooterMarkup = ##f
  evenFooterMarkup = ##f
  system-system-spacing = #'((basic-distance . 12) (minimum-distance . 8) (padding . 1) (stretchability . 4))
}
\layout {
  \context { \Score
    autoBeaming = ##f
    barNumberFormatter = #(lambda (number position alternative context) (number->string number))
  }
  \context { \PianoStaff
    connectArpeggios = ##f
    \override StaffGrouper.staff-staff-spacing = #'((basic-distance . 10) (minimum-distance . 8) (padding . 1) (stretchability . 0))
  }
  \context { \Staff pedalSustainStyle = #'text }
  \context { \Voice
    \override Slur.height-limit = #3
    \override Slur.ratio = #0.25
    \override Fingering.font-size = #-3
    \override Script.font-size = #-1
    \override Rest.direction = #UP
    \override TextSpanner.style = #'dashed-line
    \override TextSpanner.bound-details.left.text = ##f
    \override TextSpanner.bound-details.right.text = ##f
    \override TextSpanner.bound-details.right.padding = #0.5
  }
}
#(define (pedal-offset dx dy)
   (lambda (grob)
     (let* ((staff (ly:grob-object grob 'staff-symbol))
            (space (ly:staff-symbol-staff-space grob)))
       (if (ly:grob? staff)
           (let* ((common (ly:grob-common-refpoint grob staff Y))
                  (current-y (- (ly:grob-relative-coordinate grob common Y)
                                (ly:grob-relative-coordinate staff common Y))))
             (cons (* dx space) (- (* dy space) current-y)))
           (cons (* dx space) (* dy space))))))
pedalMark =
#(define-music-function (dx dy on parentheses) (number? number? boolean? boolean?)
   #{ <>-\tweak outside-staff-priority ##f
        -\tweak self-alignment-X #LEFT
        -\tweak X-offset #0 -\tweak Y-offset #0
        -\tweak extra-offset #(pedal-offset dx dy)
        _\markup \concat {
          #(if parentheses "(" "")
          \musicglyph #(if on "pedal.Ped" "pedal.*")
          #(if parentheses ")" "")
        } #})
beamCounts = #(define-music-function (left right) (integer? integer?)
  #{ \set stemLeftBeamCount = #left \set stemRightBeamCount = #right #})



centerRest = { \once \override Rest.staff-position = #0 }
beamInfo = #(define-music-function (l r) (integer? integer?)
 #{ \set stemLeftBeamCount = #l \set stemRightBeamCount = #r #})


% Compact cross-staff curves: native endpoints are retained.
#(define (compact-head-y g side fallback)
  (let* ((bound (ly:spanner-bound g side))
         (heads (ly:grob-object bound 'note-heads))
         (hs (if (ly:grob-array? heads) (ly:grob-array->list heads) '()))
         (dir (ly:grob-property g 'direction 1))
         (ss (ly:staff-symbol-staff-space g)))
    (if (pair? hs)
      (let ((ys (map (lambda (h)
         (let ((common (ly:grob-common-refpoint h g Y)))
           (- (ly:grob-relative-coordinate h common Y)
              (ly:grob-relative-coordinate g common Y)))) hs)))
        (+ ((if (> dir 0) max min) (apply min ys) (apply max ys)) (* dir ss .7)))
      fallback)))
#(define (compact-cross-staff-slur g)
  (let* ((p (ly:slur::calc-control-points g))
         (a (car p)) (b (list-ref p 3))
         (a (cons (car a) (compact-head-y g LEFT (cdr a))))
         (b (cons (car b) (compact-head-y g RIGHT (cdr b))))
         (w (- (car b) (car a))) (ss (ly:staff-symbol-staff-space g))
         (dir (ly:grob-property g 'direction 1))
         (edge (if (> dir 0) (max (cdr a) (cdr b)) (min (cdr a) (cdr b))))
         (h (+ edge (* dir ss 2.5))))
    (list a (cons (+ (car a) (* .18 w)) h)
            (cons (+ (car a) (* .78 w)) h) b)))


% Local engraving refinements are attached to the affected events.
% Coordinates use staff spaces (positive y is upward). They do not alter
% pitch, duration, voice membership, phrasing endpoints or MIDI playback.
% The retained layout extents preserve this edition's fixed page/line plan.
#(define (engraving-piece-index g)
   (let* ((orig (ly:grob-original g))
          (parts (if (and (ly:grob? orig) (ly:spanner? orig))
                     (ly:spanner-broken-into orig) '())))
     (let loop ((ps parts) (i 0))
       (cond ((null? ps) 0) ((eq? g (car ps)) i)
             (else (loop (cdr ps) (+ i 1)))))))
#(define (engraving-repair printer rows)
  (lambda (g)
    (let* ((original (printer g))
           (op (assoc-get (engraving-piece-index g) rows #f)))
      (if (and op (ly:stencil? original))
        (let ((new
          (case (car op)
            ((shift) (ly:stencil-translate original (cons (cadr op) (caddr op))))
            ((hide) (ly:make-stencil '(combine-stencil) '(0 . 0) '(0 . 0)))
            ((curve)
              (let ((cp (ly:grob-property g 'control-points)))
                (ly:grob-set-property! g 'control-points
                  (map (lambda (p d) (cons (+ (car p) (car d)) (+ (cdr p) (cdr d)))) cp (cdr op)))
                (let ((result (printer g)))
                  (ly:grob-set-property! g 'control-points cp) result)))
            (else original))))
          (ly:make-stencil (ly:stencil-expr new)
            (ly:stencil-extent original X) (ly:stencil-extent original Y))) original))))

